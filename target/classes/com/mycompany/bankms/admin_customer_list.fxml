<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: #ecf0f1; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.bankms.AdminCustomerListController">
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label text="Registered Clients" textFill="#2c3e50">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#goToAddClient" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Add New Client" />
         </children>
      </HBox>
      
      <TableView fx:id="clientTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Full Name" />
          <TableColumn fx:id="emailColumn" prefWidth="180.0" text="Email" />
          <TableColumn fx:id="phoneColumn" prefWidth="120.0" text="Phone" />
          <TableColumn fx:id="accountColumn" prefWidth="120.0" text="Account #" />
          <TableColumn fx:id="balanceColumn" prefWidth="100.0" text="Balance" />
          <TableColumn fx:id="statusColumn" prefWidth="80.0" text="Status" />
        </columns>
         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
      </TableView>
      
      <Button mnemonicParsing="false" onAction="#goBack" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Back to Dashboard" />
      <!-- Add this button inside the HBox with other buttons in admin_customer_list.fxml -->
<Button mnemonicParsing="false" onAction="#handleToggleFreeze" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Freeze/Unfreeze Account" />
<Label fx:id="statusMsgLabel" textFill="red" />
<Button mnemonicParsing="false" onAction="#handleResetPassword" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="Reset Password" />
   </children>
</VBox>