<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="root" stylesheets="@../../../css/client.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.bankms.TransactionHistoryController">
    <padding><javafx.geometry.Insets bottom="30" left="30" right="30" top="30" /></padding>
    <Label styleClass="header-label" text="My Transaction History" />
    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateCol" prefWidth="150" text="Date" />
            <TableColumn fx:id="typeCol" prefWidth="120" text="Type" />
            <TableColumn fx:id="amountCol" prefWidth="100" text="Amount" />
            <TableColumn fx:id="descCol" prefWidth="300" text="Description" />
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
    </TableView>
</VBox>