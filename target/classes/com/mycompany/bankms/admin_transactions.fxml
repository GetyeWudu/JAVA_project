<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #ecf0f1; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.bankms.AdminTransactionsController">
   <children>
      <Label text="System Audit Logs (All Transactions)" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="accountColumn" prefWidth="120.0" text="Account #" />
          <TableColumn fx:id="typeColumn" prefWidth="100.0" text="Type" />
          <TableColumn fx:id="amountColumn" prefWidth="100.0" text="Amount" />
          <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date" />
          <TableColumn fx:id="descColumn" prefWidth="300.0" text="Description" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
      <Button mnemonicParsing="false" onAction="#goBack" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Back to Dashboard" />
      <Button mnemonicParsing="false" onAction="#handleExportCSV" text="Export to CSV" />
   </children>
</VBox>