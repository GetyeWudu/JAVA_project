<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.mycompany.bankms.ChangePasswordController"
      spacing="15" alignment="CENTER" >

    <Label text="Change Password" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <PasswordField fx:id="oldPasswordField" promptText="Current Password" />
    <PasswordField fx:id="newPasswordField" promptText="New Password" />
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm New Password" />

    <Button text="Change Password" onAction="#handleChangePassword" />
    <Label fx:id="statusLabel" textFill="red" />
</VBox>
