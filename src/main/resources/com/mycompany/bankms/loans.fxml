<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="30.0" styleClass="root" stylesheets="@../../../css/client.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.bankms.LoanController">
   <children>
      <!-- LEFT: Application Form (Fixed Width) -->
      <VBox minWidth="350.0" prefWidth="400.0" spacing="20.0" styleClass="card">
         <children>
            <Label styleClass="header-label" text="Loan Application" textFill="#2c3e50">
               <font><Font name="System Bold" size="22.0" /></font>
            </Label>
            <Label text="Apply for a loan instantly. Subject to approval." textFill="#7f8c8d" wrapText="true" />
            
            <Separator prefWidth="200.0" />
            
            <VBox spacing="5.0">
               <children>
                  <Label text="Loan Amount (ETB)" textFill="#2c3e50">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Label>
                  <TextField fx:id="amountField" promptText="e.g. 5000.00" styleClass="text-field" />
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <Label text="Loan Type" textFill="#2c3e50">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Label>
                  <ComboBox fx:id="loanTypeBox" maxWidth="Infinity" promptText="Select Loan Category" style="-fx-font-size: 14px;" />
               </children>
            </VBox>
            
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleApply" styleClass="action-button" text="Submit Application">
               <font><Font name="System Bold" size="14.0" /></font>
               <padding><Insets bottom="12.0" top="12.0" /></padding>
            </Button>
            
            <Label fx:id="statusLabel" wrapText="true" />
         </children>
         <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
      </VBox>

      <!-- RIGHT: History Table (Grows to fit space) -->
      <VBox spacing="15.0" styleClass="card" HBox.hgrow="ALWAYS">
         <children>
             <Label styleClass="header-label" text="My Application Status" textFill="#2c3e50" />
             <TableView fx:id="loanTable" VBox.vgrow="ALWAYS">
               <columns>
                 <TableColumn fx:id="idCol" prefWidth="50.0" text="ID" />
                 <TableColumn fx:id="amountCol" prefWidth="120.0" text="Amount Requested" />
                 <TableColumn fx:id="typeCol" prefWidth="150.0" text="Loan Type" />
                 <TableColumn fx:id="statusCol" prefWidth="120.0" text="Current Status" />
                 <TableColumn fx:id="dateCol" prefWidth="150.0" text="Date Applied" />
               </columns>
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
             </TableView>
         </children>
         <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
      </VBox>
   </children>
   <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
</HBox>