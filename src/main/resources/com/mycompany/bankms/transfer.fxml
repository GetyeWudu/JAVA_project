<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.mycompany.bankms.TransferController"
      spacing="15" alignment="CENTER" >
    
    <Label text="Transfer Money" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TextField fx:id="targetAccountField" promptText="Target Account Number" />
    <TextField fx:id="amountField" promptText="Amount to Transfer" />

    <Button text="Transfer" onAction="#handleTransfer" />
    <Label fx:id="statusLabel" textFill="blue" />

</VBox>
