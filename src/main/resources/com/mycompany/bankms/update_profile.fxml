<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" styleClass="root" stylesheets="@../../../css/client.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.bankms.UpdateProfileController">
    <!-- Personal Information Section -->
    <VBox maxWidth="450" spacing="15" styleClass="card">
        <Label styleClass="header-label" text="Update Personal Information" />
        <Separator />
        <Label text="Email Address" />
        <TextField fx:id="emailField" />
        <Label text="Phone Number" />
        <TextField fx:id="phoneField" />
        <Label text="Residential Address" />
        <TextArea fx:id="addressField" prefHeight="80" wrapText="true" />
        <Button maxWidth="Infinity" onAction="#handleUpdate" styleClass="action-button" text="Save Changes" />
        <Label fx:id="statusLabel" style="-fx-text-fill: red;" />
    </VBox>
    
    <!-- Password Change Section -->
    <VBox maxWidth="450" spacing="15" styleClass="card">
        <Label styleClass="header-label" text="Change Password" />
        <Separator />
        <Label text="Current Password" />
        <PasswordField fx:id="currentPasswordField" />
        <Label text="New Password (min 8 chars, 1 upper, 1 lower, 1 digit, 1 special)" />
        <PasswordField fx:id="newPasswordField" />
        <Label text="Confirm New Password" />
        <PasswordField fx:id="confirmPasswordField" />
        <Button maxWidth="Infinity" onAction="#handleChangePassword" styleClass="action-button" text="Change Password" style="-fx-background-color: #e67e22;" />
        <Label fx:id="passwordStatusLabel" style="-fx-text-fill: red;" />
    </VBox>
</VBox>