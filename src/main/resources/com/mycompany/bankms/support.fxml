<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.mycompany.bankms.SupportController"
      spacing="15" alignment="CENTER">

    <Label text="Contact Support" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TextField fx:id="subjectField" promptText="Subject" />
    <TextArea fx:id="messageArea" promptText="Your message..." prefRowCount="5" wrapText="true" />

    <Button text="Send Message" onAction="#handleSendMessage" />
    <Label fx:id="statusLabel" textFill="green" />
</VBox>
